# Your configuration — holds the database password and the storage encryption
# key. Never commit it; start from compose/.env.example.
compose/.env
compose/.env.bak
compose/docker-compose.override.yml

# An unfinished configuration from ./tasksense. Kept deliberately so a run that
# stopped can be resumed, and it holds the same secrets the finished file does.
compose/.env.draft

# The Helm values ./tasksense writes. Same reason: unless you moved the four
# required values into a Secret, this file holds the storage key and the
# database URI. See docs/02-INSTALL-KUBERNETES.md.
my-values.yaml

# Backups contain the whole database, uploaded files and your secrets.
backups/

# Container image archives, unpacked from a release or produced by docker save.
images/
*.tar
*.tar.gz

# State written by upgrade.sh / rollback.sh.
.previous-version

# Diagnostics bundles.
tasksense-diagnostics-*.tar.gz

# Certificates and keys, in case anyone stages them here.
*.pem
*.key
*.crt
!cosign.pub

.DS_Store
