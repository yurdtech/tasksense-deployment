# TaskSense — on-premise configuration.
#
#   1. cp .env.example .env && chmod 600 .env
#   2. Replace every <CHANGE_ME_…> value. Nothing else is required.
#   3. ../scripts/preflight.sh      catches mistakes before anything starts
#   4. ../scripts/install.sh
#
# This is the ONLY file you edit — never docker-compose.yml. The application
# validates its settings at startup and refuses to run on an invalid one,
# listing every problem at once. Lines starting with # are optional; uncomment
# a line AT MOST ONCE (a key defined twice silently uses the last one).
#
# "Bank:" marks the value we recommend for a regulated installation.
# Every variable, with defaults and failure modes: docs/17-ENVIRONMENT.md


# ─────────────────────────────────────────────────────────────────────────────
# 1. Version and images
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED. The release to run. Pin it — never "latest", or a restart can
# silently move you to another version. Change it with scripts/upgrade.sh.
TASKSENSE_VERSION=1.1.0

# Your own registry mirror (Harbor, Nexus, Quay), filled by
#   ../scripts/load-images.sh --registry harbor.bank.internal/tasksense
# Set BOTH, or the database image is still fetched from Docker Hub.
#TASKSENSE_IMAGE=harbor.bank.internal/tasksense/tasksense
#MONGO_IMAGE=harbor.bank.internal/tasksense/mongo

# The bundled MongoDB's tag (default 7). Bank: pin a full version, e.g. 7.0.14.
#MONGO_VERSION=7


# ─────────────────────────────────────────────────────────────────────────────
# 2. What runs on this host
# ─────────────────────────────────────────────────────────────────────────────

# Compose profiles, comma-separated:
#   bundled-mongo   MongoDB in a container beside the app (the default)
#   import-worker   a separate process for Jira-backup imports
# Your own MongoDB: remove bundled-mongo here AND set MONGODB_URI (section 6).
# A Jira migration: add import-worker AND set WORKER_ROLE=api.
#   e.g.  COMPOSE_PROFILES=bundled-mongo,import-worker
COMPOSE_PROFILES=bundled-mongo

# Which workloads the API process runs: all | api. Must be "api" when the
# import-worker profile is on (preflight refuses otherwise), "all" without it.
WORKER_ROLE=all


# ─────────────────────────────────────────────────────────────────────────────
# 3. Network
# ─────────────────────────────────────────────────────────────────────────────

# Host address the app is published on. Bank: keep 127.0.0.1 and run the TLS
# reverse proxy on this host; 0.0.0.0 only with the port firewalled.
BIND_ADDRESS=127.0.0.1

# Host port (the container always listens on 3000).
HTTP_PORT=3000


# ─────────────────────────────────────────────────────────────────────────────
# 4. This installation's identity
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED. The URL users type, with https://. Sign-in redirects are built
# from it, so a wrong value breaks SSO. e.g. https://tasksense.bank.internal
APP_URL=<CHANGE_ME_APP_URL>

# Browser origins allowed to call the API. Defaults to APP_URL, which is right
# when the UI and API share a host — set it only if they do not.
#CORS_ALLOWED_ORIGINS=https://tasksense.bank.internal

# REQUIRED on first install. Becomes the administrator of the new, empty
# workspace. No password is set: sign in via your identity provider, or claim
# the account with "Create account" on the login screen. No default credential.
FIRST_ADMIN_EMAIL=<CHANGE_ME_ADMIN_EMAIL>

# Emails always granted the admin role, comma-separated. Bank: keep unset —
# administrators are granted inside the app, where it is audited.
#OWNER_EMAILS=


# ─────────────────────────────────────────────────────────────────────────────
# 5. Secrets
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED, at least 32 characters. Generate:  openssl rand -base64 32
# Encrypts stored credentials (storage keys, model API keys, LDAP bind
# passwords). Changing it makes them unreadable. Back it up WITH the database.
STORAGE_SECRET=<CHANGE_ME_STORAGE_SECRET>

# Licence key (starts with tsl_), verified offline — no phone-home. Without
# one: 10 accounts, 500 automation runs a month. docs/14-LICENSING.md
#LICENSE_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# 6. Database
# ─────────────────────────────────────────────────────────────────────────────

# ── The bundled MongoDB (profile bundled-mongo) ──────────────────────────────
# REQUIRED with bundled-mongo; leave both EMPTY with your own MongoDB.
# Applied ONLY when the data volume is first created — changing them later
# does not change the existing user (docs/10-TROUBLESHOOTING.md).
MONGO_USER=tasksense
# Generate:  openssl rand -hex 24   (hex: it goes inside a connection string)
MONGO_PASSWORD=<CHANGE_ME_MONGO_PASSWORD>

# ── Your own MongoDB (remove bundled-mongo from COMPOSE_PROFILES) ────────────
# Replica set, TLS with your CA, dedicated user — docs/16-EXTERNAL-DATABASES.md.
# Percent-encode / : @ ? # [ ] % in the password. The CA file goes in
# compose/certs/ and is named by its path INSIDE the container (/certs/…).
#MONGODB_URI=mongodb://tasksense:PASSWORD@mongo-0.bank.internal:27017,mongo-1.bank.internal:27017,mongo-2.bank.internal:27017/?replicaSet=rs0&tls=true&tlsCAFile=/certs/bank-ca.pem&authSource=admin

# Database name inside the server (default tasksense). Backups dump this one.
MONGODB_DB=tasksense

# Wire compression: zlib | none. none for the bundled same-host MongoDB;
# Bank (own MongoDB across a network): zlib.
MONGODB_COMPRESSORS=none

# Server-selection timeout, ms (default 5000). Bank (own MongoDB): 15000.
#MONGODB_TIMEOUT_MS=15000

# Deadline of one database operation, ms (default 30000; 0 disables it).
#MONGODB_OP_TIMEOUT_MS=30000

# Connection pool: kept open while idle (default 10), and the ceiling (100).
#MONGODB_MIN_POOL_SIZE=10
#MONGODB_MAX_POOL_SIZE=100


# ─────────────────────────────────────────────────────────────────────────────
# 7. Sign-in
#
# Active Directory / LDAP has NO variables here: a workspace administrator
# configures it in the app (Admin → Authentication) — several domains, bind
# passwords encrypted with STORAGE_SECRET, the CA pasted as text, a live
# connection test, no restart. Leftover LDAP_* lines from 1.0 are ignored.
# Local passwords always remain as a fallback: keep one local administrator.
# Walkthroughs: docs/05-IDENTITY.md
# ─────────────────────────────────────────────────────────────────────────────

# How long a sign-in lasts, hours (app default 720 = 30 days; 0 = never
# expires). Bank: 12. A workspace policy (Admin → Security) still wins.
SESSION_TTL_HOURS=12

# ── OIDC (Keycloak, AD FS, Azure AD, Okta) ───────────────────────────────────
# Issuer URL; <issuer>/.well-known/openid-configuration must be reachable.
#OIDC_ISSUER=https://sso.bank.internal/realms/corporate
# Client registered at the identity provider, and its secret.
#OIDC_CLIENT_ID=tasksense
#OIDC_CLIENT_SECRET=
# Register this exact URI at the provider (defaults to APP_URL + this path).
#OIDC_REDIRECT_URI=https://tasksense.bank.internal/api/v1/auth/oidc/callback
# Text on the sign-in button.
#OIDC_LABEL=Sign in with corporate account


# ─────────────────────────────────────────────────────────────────────────────
# 8. Mail
#
# Unset, notifications still appear in the app; only email is skipped.
# ─────────────────────────────────────────────────────────────────────────────

# Your internal relay.
#SMTP_HOST=smtp.bank.internal
# 25 internal relay, 587 submission + STARTTLS (app default), 465 implicit TLS.
#SMTP_PORT=25
# true = TLS from the first byte (465 only). STARTTLS on 587 is still encrypted.
#SMTP_SECURE=false
# Only if the relay authenticates.
#SMTP_USER=
#SMTP_PASS=
# The From address — one your relay accepts, in your own domain.
#EMAIL_FROM=TaskSense <tasksense@bank.internal>


# ─────────────────────────────────────────────────────────────────────────────
# 9. Uploads and Jira import
#
# Files go to the data volume by default; shared or replicated storage
# (S3-compatible, WebDAV) is connected later in Admin → Storage. Set the same
# body limits on your reverse proxy, or large uploads fail before arriving —
# examples/nginx.conf.
# ─────────────────────────────────────────────────────────────────────────────

# Per-file upload ceiling, MB.
STORAGE_MAX_FILE_MB=25

# Per-file ceiling for inline video (mp4/webm/mov), MB (default 200).
#STORAGE_MAX_VIDEO_FILE_MB=200

# Largest Jira site backup (entities.xml) accepted, GB. It is staged on the
# data volume: keep at least twice this free there (preflight checks).
JIRA_BACKUP_MAX_GB=20

# Days an uploaded Jira backup is kept for further landings (default 7).
#JIRA_BACKUP_RETENTION_DAYS=7


# ─────────────────────────────────────────────────────────────────────────────
# 10. Large workspaces (a migrated Jira instance)
# ─────────────────────────────────────────────────────────────────────────────

# Tasks one board snapshot carries before it says how many it withheld (5000).
#STATE_TASK_LIMIT=5000

# Rows one report reads before it says it stopped (default 150000).
#REPORTS_MAX_TASKS=150000

# Automation minutes per workspace per 12 h before rules are throttled
# (default 60, as in Jira; 0 lifts it). Raise it if MongoDB is far away.
#AUTOMATION_PROCESSING_MINUTES_PER_12H=60


# ─────────────────────────────────────────────────────────────────────────────
# 11. AI features (optional)
#
# Off unless configured: connect an OpenAI-compatible endpoint INSIDE your
# network (vLLM, Ollama, a gateway) in Admin → Agents → Providers.
# docs/12-AI-MODELS.md
# ─────────────────────────────────────────────────────────────────────────────

# Agent command execution. MUST stay off: no sandbox ships on-premise, so
# "on"/"auto" are refused at boot and "unsafe-host" would run model-authored
# commands on this server. Preflight blocks anything but off.
AGENT_EXECUTOR=off

# The scheduler that advances agent tasks: on | off (app default on).
# Bank: off until the AI features are actually in use.
AGENT_DISPATCHER=off


# ─────────────────────────────────────────────────────────────────────────────
# 12. Security and operations
# ─────────────────────────────────────────────────────────────────────────────

# The interactive API browser at /api/v1/swagger. ON in the app unless false,
# and it publishes the whole API surface. Bank: false (true while integrating).
SWAGGER_ENABLED=false

# Hosts the app may call beyond those configured elsewhere (self-hosted GitLab,
# internal Jira), comma-separated. Everything else — private and link-local
# addresses included — is refused, so a webhook URL cannot probe your network.
#EGRESS_ALLOWLIST=gitlab.bank.internal,jira.bank.internal

# Your internal CA bundle (PEM), for TLS to MongoDB, SMTP, OIDC and an LLM
# gateway. Copy it into compose/certs/ and name its path INSIDE the container.
#NODE_EXTRA_CA_CERTS=/certs/bank-ca.pem

# json (one object per line, for Splunk/QRadar/Elastic) | text.
LOG_FORMAT=json

# verbose | debug | log | warn | error | fatal — there is no "info"; "log" is
# the ordinary level.
LOG_LEVEL=log

# Prometheus metrics at /api/v1/metrics, behind a bearer token. Without a
# token they stay off. Generate:  openssl rand -hex 32
#METRICS_ENABLED=true
#METRICS_TOKEN=

# Where rate-limit counters live: memory (default; the API is one process) |
# mongo (survives restarts, one extra round trip per throttled request).
#RATE_LIMIT_STORE=memory


# ─────────────────────────────────────────────────────────────────────────────
# 13. Resources — sizing table in docs/11-SIZING.md
#
# Heaps are about 75% of the container's memory limit; MongoDB's cache about
# half of its own. A heap larger than its limit is an OOM kill, not a speed-up.
# ─────────────────────────────────────────────────────────────────────────────

# The API (and the one-shot migrate job).
APP_HEAP_MB=1536
APP_CPU_LIMIT=2
APP_MEMORY_LIMIT=2g

# The import worker — only with the import-worker profile. A landing of a
# large Jira site needs the headroom.
WORKER_HEAP_MB=4096
WORKER_CPU_LIMIT=2
WORKER_MEMORY_LIMIT=6g

# The bundled MongoDB — only with the bundled-mongo profile.
MONGO_CACHE_GB=1
MONGO_CPU_LIMIT=2
MONGO_MEMORY_LIMIT=2g
