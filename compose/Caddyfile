# The load balancer of the replicas topology (docker-compose.replicas.yml).
# You do not edit this file; it is not your TLS proxy. That one stays where it
# was — examples/nginx.conf, examples/Caddyfile — in front of this, on the
# host, pointed at BIND_ADDRESS:HTTP_PORT as before.
#
#   host proxy (TLS) ──► lb :8080 ──► app copies :3000 (round robin)
#
# What it does, and why:
#
#   1. Upstreams are whatever Docker's DNS returns for `app` — every running
#      copy, re-read every 5 s — so APP_REPLICAS can change without touching
#      this file.
#   2. A copy that is not ready (MongoDB or Redis unreachable, still starting)
#      gets no requests: active checks on /api/v1/health/ready, and passive
#      ones — a copy that refuses connections is skipped for 10 s, and the
#      request tries the next.
#   3. Live-update streams (server-sent events) are passed through unbuffered.
#   4. X-Forwarded-For is APPENDED to, not replaced: the host proxy's request
#      comes from a private address, which is trusted, so the client address
#      it recorded survives. The application then counts two hops
#      (TRUST_PROXY=2). Replaced, every client would look like the host proxy
#      and anonymous traffic would share one rate-limit bucket.
#   5. Upstream keep-alive shorter than the application's 65 s, as in the
#      host examples, so a request is never sent down a closing socket.
#   6. Request bodies up to 1 MiB are buffered, so the try on the next copy
#      can send them again. Caddy retries a POST or PATCH only when the first
#      copy never received it (the connection failed). Without the buffer
#      that retry has no body left and fails with 502. This was measured: one
#      write failed each time a copy started, stopped or was killed. Larger
#      bodies, such as uploads and Jira backups, stream through unbuffered as
#      before.
#
# No TLS, no admin API, nothing written to disk: it listens on the compose
# network and on the loopback port the host proxy reaches.

{
	admin off
	auto_https off
	persist_config off
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	reverse_proxy {
		dynamic a app 3000 {
			refresh 5s
		}
		lb_policy round_robin
		lb_try_duration 5s
		request_buffers 1MiB

		health_uri /api/v1/health/ready
		health_interval 5s
		health_timeout 3s
		health_status 2xx
		fail_duration 10s

		flush_interval -1
		transport http {
			keepalive 60s
		}
	}
}
