# TaskSense — on-premise configuration.
#
#   cp .env.example .env && chmod 600 .env
#
# Settings marked REQUIRED have no sensible default. The application validates
# this whole file at startup and refuses to run on an invalid one, listing every
# problem at once — so a failed start is a readable error, not a mystery.
#
# Full reference for every variable: docs/04-CONFIGURATION.md


# ─────────────────────────────────────────────────────────────────────────────
# 1. Version and access
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED. The release you are running. Pin it explicitly — never "latest",
# or a restart can silently move you to a different version.
TASKSENSE_VERSION=1.0.0

# Change only if you mirror the image into your own registry:
#   ../scripts/load-images.sh --registry harbor.bank.internal/tasksense
#TASKSENSE_IMAGE=harbor.bank.internal/tasksense/tasksense
#MONGO_IMAGE=harbor.bank.internal/tasksense/mongo

# Where the container listens on this host. Keep the loopback address unless
# your reverse proxy runs on a different machine.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=3000


# ─────────────────────────────────────────────────────────────────────────────
# 2. This installation's identity
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED. The URL users type, including scheme. Sign-in redirects are built
# from it, so a wrong value breaks SSO in a way that is confusing to debug.
APP_URL=https://tasksense.bank.internal

# Browser origins allowed to call the API. With the UI and API on one host —
# the normal setup — this is the same value as APP_URL.
CORS_ALLOWED_ORIGINS=https://tasksense.bank.internal

# REQUIRED on first install. Becomes the administrator of the new, empty
# workspace. No password is set for it: sign in through your identity provider,
# or register with this address to choose one. There is no default credential.
FIRST_ADMIN_EMAIL=admin@bank.internal


# ─────────────────────────────────────────────────────────────────────────────
# 3. Secrets
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED, minimum 32 characters. Generate:  openssl rand -base64 32
#
# Encrypts stored credentials at rest — object-storage keys, language-model API
# keys. Treat it like a database password.
#
# Changing it makes previously stored credentials unreadable; they have to be
# re-entered in the admin console. Back it up with the database: a restore
# without this value restores unusable credentials.
STORAGE_SECRET=

# REQUIRED. The database account the application uses.
#
# Generate the password:  openssl rand -hex 24
#
# Hex, not base64. This value is substituted into a MongoDB connection string,
# and a URI reads / : @ ? # [ ] and % as structure — a password containing one
# ends early and the driver refuses the whole URI with "Password contains
# unescaped characters", before it has tried to connect to anything.
MONGO_USER=tasksense
MONGO_PASSWORD=

# Your licence key (starts with tsl_). Verified offline — no activation server,
# no phone-home, no usage reporting.
#
# Without one: 10 accounts and 500 automation runs a month. Everything else is
# the same software. An expired licence never blocks access to your data, and
# going over the seat count never stops anybody signing in — the overage is
# reported instead. See docs/14-LICENSING.md; ask at info@meiksense.io.
#LICENSE_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# 4. Sign-in
#
# Pick ONE primary method. Full walkthroughs: docs/05-IDENTITY.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Active Directory / LDAP ──────────────────────────────────────────────────
# Use ldaps:// — ldap:// sends the bind password in clear text.
#LDAP_URL=ldaps://dc01.bank.internal:636
#LDAP_BIND_DN=CN=svc-tasksense,OU=Service Accounts,DC=bank,DC=internal
#LDAP_BIND_PASSWORD=
#LDAP_BASE_DN=DC=bank,DC=internal
# {{username}} is replaced with what the user typed.
#LDAP_USER_FILTER=(sAMAccountName={{username}})
# Your internal CA, so the certificate actually gets verified. Put the file in
# compose/certs/ — that directory is mounted at /certs inside the container, and
# this path is the one inside it.
#LDAP_TLS_CA=/certs/bank-ca.pem
# Directory group → TaskSense role. Re-evaluated at every sign-in, so revoking
# a group membership in AD takes effect on the user's next login.
#LDAP_GROUP_MAP=CN=TaskSense-Admins,OU=Groups,DC=bank,DC=internal=admin;CN=TaskSense-Users,OU=Groups,DC=bank,DC=internal=member

# ── OIDC (Keycloak, AD FS, Azure AD, Okta) ───────────────────────────────────
#OIDC_ISSUER=https://sso.bank.internal/realms/corporate
#OIDC_CLIENT_ID=tasksense
#OIDC_CLIENT_SECRET=
# Register this exact URI at the identity provider.
#OIDC_REDIRECT_URI=https://tasksense.bank.internal/api/v1/auth/oidc/callback
#OIDC_LABEL=Sign in with corporate account

# ── Local passwords ──────────────────────────────────────────────────────────
# Always available as a fallback. Keep at least one local administrator so an
# identity-provider outage cannot lock you out of your own instance.


# ─────────────────────────────────────────────────────────────────────────────
# 5. Mail
#
# Unset, notifications still appear in the application; only email is skipped.
# ─────────────────────────────────────────────────────────────────────────────

#SMTP_HOST=smtp.bank.internal
#SMTP_PORT=25
#SMTP_SECURE=false
#SMTP_USER=
#SMTP_PASS=
#EMAIL_FROM=TaskSense <tasksense@bank.internal>


# ─────────────────────────────────────────────────────────────────────────────
# 6. File storage
#
# Default: the container's data volume. Fine for most installs — back it up
# together with the database. For shared or replicated storage, point at your
# own S3-compatible service or WebDAV server from Admin → Storage.
# ─────────────────────────────────────────────────────────────────────────────

# Per-file upload ceiling, megabytes. Also set the body limit on your reverse
# proxy (nginx: client_max_body_size) or large uploads fail before arriving.
STORAGE_MAX_FILE_MB=25


# ─────────────────────────────────────────────────────────────────────────────
# 7. AI features (optional)
#
# Off unless configured. To enable them, connect an OpenAI-compatible endpoint
# running INSIDE your network — vLLM, Ollama, or a gateway — from
# Admin → Agents → Providers. Nothing here sends data outside.
# See docs/12-AI-MODELS.md.
# ─────────────────────────────────────────────────────────────────────────────

# The agent executor runs model-authored commands in a sandboxed workspace.
# Off by default on-premise, and it should stay off unless you have reviewed
# what it does and decided you want it.
AGENT_EXECUTOR=off

# The background scheduler that advances agent tasks. Leave off if you are not
# using the AI features; it costs one wake-up every 15 seconds otherwise.
AGENT_DISPATCHER=off


# ─────────────────────────────────────────────────────────────────────────────
# 8. Operations
# ─────────────────────────────────────────────────────────────────────────────

# Structured JSON, one object per line — for Splunk, QRadar, Elastic.
# Use "text" only when reading logs by eye during an install.
LOG_FORMAT=json

# One of: verbose, debug, log, warn, error, fatal. These are the application's
# own level names, not syslog's — there is no "info", and "log" is the ordinary
# one that means the same thing.
LOG_LEVEL=log

# Prometheus metrics at /api/v1/metrics. The endpoint requires this bearer
# token; generate one with:  openssl rand -hex 32
#METRICS_ENABLED=1
#METRICS_TOKEN=

# The interactive API browser. It publishes the complete API surface, so it is
# off by default. Turn it on temporarily if you are building an integration.
#SWAGGER_ENABLED=1

# Hosts the application may call out to, beyond those configured above —
# a self-hosted GitLab, an internal Jira. Everything else is refused, including
# private and link-local addresses, which stops a malicious webhook URL from
# being used to probe your network.
#EGRESS_ALLOWLIST=gitlab.bank.internal,jira.bank.internal


# ─────────────────────────────────────────────────────────────────────────────
# 9. Resource limits
# ─────────────────────────────────────────────────────────────────────────────

APP_CPU_LIMIT=2
APP_MEMORY_LIMIT=2g
MONGO_CPU_LIMIT=2
MONGO_MEMORY_LIMIT=2g
